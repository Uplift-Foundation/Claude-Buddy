<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeBuddy.AccountOrbWindow"
        Width="72" Height="72"
        SizeToContent="Manual"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <!-- A ring in the danger band breathes, and this is the whole of how.
         Code does nothing but add or remove the class — see StartBreathing in
         AccountOrbWindow.axaml.cs.

         Declarative because Avalonia's contract leaves no choice: an animation
         with IterationCount="Infinite" is *applied* by a style, never *run*.
         Animation.RunAsync rejects one outright with
         InvalidOperationException("Looping animations must not use the Run
         method."), and building one and calling RunAsync on it is exactly what
         the first version of this did — fire-and-forget, so the throw never
         reached the dispatcher and landed instead in the crash log as an
         unobserved task exception — twenty-two entries across twelve separate
         runs of the app, counted on 7 Sep 2026. See the same note in
         AccountOrbWindow.axaml.cs, which is where that count is explained; if
         you are updating one of them, update both.

         Be precise about what that cost, because measuring it changed the
         answer. On Avalonia 12.1.1 RunAsync faults the *returned task* rather
         than throwing before it acts: it applies the animation anyway and then
         awaits a task it has already failed. So the pre-fix ring did breathe —
         confirmed over five scenarios on a real Mac, including the exact
         reading that was reported (a weekly ring at 92% beside an extra-usage
         ring at 100%), shown before and after the reading arrived, and hidden
         and reshown mid-cycle. What was actually broken was the contract: a
         call the framework has already declared invalid, kept working only by
         the order in which that particular version happens to give up, plus a
         faulted task per ring left for the finalizer to complain about. That is
         a thing that stops working on a bump with nothing in the release notes
         to warn you, which is the argument for the supported path rather than
         for a symptom.

         The animation lives on the window rather than in App.axaml because
         nothing outside this window has a ring to breathe, and a `Path.breathing`
         selector at application scope would silently claim every Path in the app
         — the CLI marks on the session orbs among them.

         2600ms alternating with a sine ease is a breath rather than a blink: fast
         enough to catch the eye in peripheral vision, slow enough that a row of
         orbs at 100% is not a strobe. 0.55 rather than 0 at the far end because a
         ring that vanishes is a ring you cannot read the sweep of, and the sweep
         is the number. -->
    <Window.Styles>
        <Style Selector="Path.breathing">
            <Style.Animations>
                <Animation Duration="0:0:2.6"
                           IterationCount="Infinite"
                           PlaybackDirection="Alternate"
                           Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.55"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <!-- One account's usage, as an orb wearing three rings.

         Bigger than OrbWindow's 56 and centred at (36,36) rather than (28,28),
         which is safe here and would not be there: the session orb's centre is
         hardcoded in TeamLinks and ChatPanel, which reach for it by name, while
         nothing reaches for an account orb. Three concentric rings plus two
         legible letters do not fit in 36 device-independent pixels, and the
         letters are what tell two accounts apart.

         Root is pinned to 72x72 at the top left for the same reason OrbWindow's
         is pinned to 56: Windows floors a top-level window at
         SM_CXMINTRACK/SM_CYMINTRACK, so the window is wider than this on that
         platform and the surplus is transparent slack to the right. Window size
         can never be a layout input here.

         The rings themselves are drawn in code — see AccountOrbWindow.axaml.cs —
         because their sweep is the data. This is the first arc drawing in the
         app; the arithmetic lives in UsageRingGeometry so it can be tested
         without any of this. -->
    <Canvas x:Name="Root"
            Width="72" Height="72"
            Background="Transparent"
            Cursor="Hand"
            HorizontalAlignment="Left" VerticalAlignment="Top">

        <!-- The unfilled part of each ring, so a ring at 3% still reads as a
             ring rather than as a stray tick floating above an orb. -->
        <Ellipse x:Name="WeeklyTrack" Canvas.Left="4" Canvas.Top="4"
                 Width="64" Height="64"
                 Stroke="#17FFFFFF" StrokeThickness="5"/>
        <Ellipse x:Name="SessionTrack" Canvas.Left="11" Canvas.Top="11"
                 Width="50" Height="50"
                 Stroke="#17FFFFFF" StrokeThickness="5"/>

        <!-- The inner ring is a track only when there is something to track.
             An account with extra usage switched off has no cap to be a
             fraction of, and gets the dotted absence set up in code instead. -->
        <Ellipse x:Name="ExtraTrack" Canvas.Left="18" Canvas.Top="18"
                 Width="36" Height="36"
                 Stroke="#17FFFFFF" StrokeThickness="5"/>

        <Path x:Name="WeeklyArc" StrokeThickness="5" StrokeLineCap="Round"/>
        <Path x:Name="SessionArc" StrokeThickness="5" StrokeLineCap="Round"/>
        <Path x:Name="ExtraArc" StrokeThickness="5" StrokeLineCap="Round"/>

        <Ellipse x:Name="Disc" Canvas.Left="22" Canvas.Top="22"
                 Width="28" Height="28"
                 Fill="#F51C1C1E" Stroke="#B8FFFFFF" StrokeThickness="1.5"/>

        <TextBlock x:Name="Glyph"
                   Canvas.Left="22" Canvas.Top="22"
                   Width="28" Height="28"
                   FontSize="12"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   Foreground="#F2FFFFFF"
                   IsHitTestVisible="False">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="5"/>
            </TextBlock.RenderTransform>
        </TextBlock>

        <!-- Which CLI this account is. Bottom-left of the 72 window, on the
             weekly ring rather than on the 28px disc — a 22px mark on that
             disc would cover the letters it is supposed to sit beside. Same
             size as the session orb's mark so a mixed row reads as Claude /
             Codex / Grok from across the desk. -->
        <Border x:Name="CliBadge"
                Canvas.Left="2" Canvas.Top="48"
                Width="22" Height="22"
                CornerRadius="11"
                IsVisible="False"
                BorderBrush="#73FFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Path x:Name="CliGlyph"
                  Width="14" Height="14"
                  Stretch="Uniform"
                  Fill="#F2FFFFFF"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"/>
        </Border>

        <!-- Shown while this account's card is pinned. Top-right, which is free
             here: the session orb's four badge corners are all spoken for, but
             an account orb has no kind, no heartbeat and no presence to show. -->
        <Border x:Name="PinBadge"
                Canvas.Left="52" Canvas.Top="2"
                Width="18" Height="18"
                CornerRadius="9"
                IsVisible="False"
                Background="#F51C1C1E"
                BorderBrush="#66FFFFFF"
                BorderThickness="1">
            <TextBlock Text="&#128204;"
                       FontSize="9"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Border>
    </Canvas>
</Window>
