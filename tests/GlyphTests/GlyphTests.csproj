<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>GlyphTests</AssemblyName>
    <RootNamespace>ClaudeBuddy.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shipped file, compiled in rather than copied, so a test that
         passes is a statement about the app and not about a snapshot of it.
         No Avalonia reference: nothing here draws, and OrbGlyph knows about
         neither windows nor settings. -->
    <Compile Include="../../OrbGlyph.cs" />
  </ItemGroup>

</Project>
