<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>ArrangementTests</AssemblyName>
    <RootNamespace>ClaudeBuddy.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia for PixelPoint and PixelRect only; nothing here draws.
         Matches the app's own Avalonia 12.1.1 pin even though this project
         has no ProjectReference to ClaudeBuddy.csproj and so isn't exposed
         to the cross-major-version MissingMethodException that forced that
         pin elsewhere — kept in step anyway so one Avalonia version doesn't
         silently drift across the repo. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped files, compiled in rather than copied, so a test that
         passes is a statement about the app and not about a snapshot of it.
         TeamLinks comes along because the arrangement asks it how much room an
         arrow needs. -->
    <Compile Include="../../OrbArrangement.cs" />
    <Compile Include="../../TeamLinkGeometry.cs" />
  </ItemGroup>

</Project>
