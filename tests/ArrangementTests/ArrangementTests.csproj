<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>ArrangementTests</AssemblyName>
    <RootNamespace>ClaudeBuddy.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia for PixelPoint and PixelRect only; nothing here draws. -->
    <PackageReference Include="Avalonia" Version="11.3.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped files, compiled in rather than copied, so a test that
         passes is a statement about the app and not about a snapshot of it.
         TeamLinks comes along because the arrangement asks it how much room an
         arrow needs. -->
    <Compile Include="../../OrbArrangement.cs" />
    <Compile Include="../../TeamLinkGeometry.cs" />
  </ItemGroup>

</Project>
