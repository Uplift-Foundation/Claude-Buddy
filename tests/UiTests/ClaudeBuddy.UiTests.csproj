<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>ClaudeBuddy.UiTests</AssemblyName>
    <RootNamespace>ClaudeBuddy.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Newer than the app's own 11.3.7 pin (ClaudeBuddy.csproj), deliberately:
         several race-condition fixes in Avalonia's own headless test
         plumbing — dispatcher lifecycle between tests, "job loop detected",
         cleanup ordering — landed in 11.3.x patches after .7 and were
         needed to stop CI failing intermittently (see
         AvaloniaUI/Avalonia#12588 and its descendants). Safe because these
         are the TEST project's own packages, not the app's: patch versions
         within one Avalonia minor line stay binary-compatible, so the app
         assembly (compiled against the 11.3.7 API surface, unchanged) and
         these newer Avalonia assemblies coexist fine in the test binary's
         output. Keep this ahead of ClaudeBuddy.csproj's pin on purpose. -->
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.20" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ClaudeBuddy.csproj" />
  </ItemGroup>
</Project>
