<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>ClaudeBuddy.UiTests</AssemblyName>
    <RootNamespace>ClaudeBuddy.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Same reasoning as tests/UiScreenshots' csproj (see its own, longer
         comment): xunit.v3's build targets require OutputType=Exe and
         UseAppHost=true, set here (not left to Microsoft.NET.Test.Sdk.targets'
         default) so the SDK's _IsExecutable/RID-inference logic sees it before
         that default fires, and SelfContained is set to match
         ClaudeBuddy.csproj so MSBuild's NETSDK1151 self-contained
         cross-check between the two referenced executables doesn't fire. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Required on the .NET 10 SDK for `dotnet test` to run an MTP project
         at all — see tests/UiScreenshots' csproj comment. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
    <!-- xUnit v3, not v2 (this suite moved alongside tests/UiScreenshots) —
         forced by Avalonia.Headless.XUnit 12.x, which depends on
         xunit.v3.extensibility.core and has no v2-compatible release.
         Pinned to 3.2.2, not the newest 4.0.0, for the same reason as
         UiScreenshots: Avalonia.Headless.XUnit 12.1.1 itself depends on
         xunit.v3.extensibility.core 3.2.2, and 4.0.0 changed a public API
         shape (Xunit.v3.TestIntrospectionHelper.GetTestCaseDetails) in a
         binary-incompatible way that fails every test at discovery. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- 12.1.1, matching the app: ClaudeBuddy.csproj moved to Avalonia 12.1.1
         to reach the real fix for the FontManager concurrency race
         (AvaloniaUI/Avalonia#21269, never backported to 11.3.x) needed by
         tests/UiScreenshots, and a test project referencing the app can no
         longer pin a different Avalonia major than the app itself —
         mismatched majors of Avalonia.Markup.Xaml loaded in one process
         break every XAML-backed control with MissingMethodException. This
         suite's previous comment about staying ahead of the app's patch
         version (11.3.20 vs 11.3.7) no longer applies now that both are on
         the same major and CI-stability patches land continuously on 12.x. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ClaudeBuddy.csproj" />
  </ItemGroup>
</Project>
