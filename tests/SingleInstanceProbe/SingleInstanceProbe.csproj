<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A second process for tests/IntegrationTests' SingleInstanceTests to claim
    the mutex from (CB-206). Compiles SingleInstance.cs in directly, the
    convention the console suites use for a file with no dependency closure,
    so the probe asks exactly the question Program.cs asks.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\SingleInstance.cs" Link="SingleInstance.cs" />
    <!-- SingleInstance.MutexName is Brand.SingleInstanceMutexName (CB-250),
         so the probe needs the constant's home to name the same mutex. -->
    <Compile Include="..\..\Brand.cs" Link="Brand.cs" />
  </ItemGroup>
</Project>
