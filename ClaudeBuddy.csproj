<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudeBuddy</AssemblyName>
    <RootNamespace>ClaudeBuddy</RootNamespace>
    <!-- The single source of truth for the shipped version. The packaging
         scripts and the release workflow all parse this element out of this
         file rather than carrying their own copy, so a release is a one-line
         edit here plus a matching tag.

         Keep the "-beta" style suffix on Version only: AssemblyVersion and
         FileVersion must be plain four-part numbers, so they are set
         explicitly from the numeric part. Version flows into
         AssemblyInformationalVersion, which is what actually shows the
         prerelease label. -->
    <Version>0.3.0-beta</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Product>Claude Buddy</Product>
    <Authors>Kawika Miller, Warren Thompson</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Uplift-Foundation/Claude-Buddy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Uplift-Foundation/Claude-Buddy</RepositoryUrl>
    <!-- Run on whatever newer runtime is installed (e.g. .NET 10 SDK only) -->
    <RollForward>LatestMajor</RollForward>
    <!-- Single-file, self-contained output when publishing; pick the RID on
         the command line: dotnet publish -c Release -r win-x64|osx-arm64|osx-x64 -->
    <!-- Embedded as the Win32 icon resource, so ClaudeBuddy.exe has a real icon
         in Explorer, the Start menu and the notification area's overflow. The
         SDK does this cross-platform, so a Mac can still produce the win-x64
         build. Ignored when targeting macOS, which uses Resources/*.icns. -->
    <ApplicationIcon>Assets/ClaudeBuddy.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tray icons (one per session state) + the .app bundle's icon source -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools/ is scripts, plus the side-car speech engine's own project (see
         tools/ClaudeBuddySpeech). The SDK's default glob is **/*.cs rooted at
         this file, so without this the side-car's source would be compiled into
         the app — dragging in the very 82MB of dependencies that keeping it a
         separate downloadable process exists to avoid. Harmless until tools/
         gained its first .cs file, which is exactly why it is easy to miss. -->
    <Compile Remove="tools\**" />

    <!-- Same trap, second door: tests/ has its own project with its own entry
         point, and the SDK's default glob would compile it into the app. It is
         also where the app's own obj/ would be walked into, which shows up as
         duplicate assembly attributes rather than as anything mentioning tests. -->
    <Compile Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The new xUnit suites reference this project rather than compiling
         individual shipped files (the tests/ArrangementTests-style
         <Compile Include>), because they need SessionManager and
         ClaudeBuddySettings, whose dependency closures are too large to pull
         in that way. A ProjectReference alone gives them only public types,
         so this grants the three of them the internal ones too — the same
         private-pure-logic (SessionManager's scan rules, AgentTeam's
         sanitizers) that made them worth testing in the first place. -->
    <InternalsVisibleTo Include="ClaudeBuddy.UnitTests" />
    <InternalsVisibleTo Include="ClaudeBuddy.IntegrationTests" />
    <InternalsVisibleTo Include="ClaudeBuddy.UiTests" />
    <InternalsVisibleTo Include="ClaudeBuddy.UiScreenshots" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <!-- ColorPicker, for the orb-colour rows in the settings window. It arrives
         transitively via the macOS theme below, but is named here on purpose: a
         theme bump that dropped it would otherwise break the build for a reason
         with nothing to do with theming. -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.7" />
    <!-- Ed25519, for the OpenClaw gateway's device identity. The gateway will
         not grant operator scopes to a bearer token alone — it answers
         DEVICE_IDENTITY_REQUIRED until the connect carries a signature over its
         challenge nonce (see docs/openclaw-findings.md) — and .NET 10's BCL
         still has no Ed25519.

         BouncyCastle rather than NSec deliberately: NSec is libsodium, so it
         ships a native dylib, and this app publishes SelfContained +
         PublishSingleFile and is signed with a Developer ID under a hardened
         runtime. Every embedded dylib then has to be signed too, and the
         comment at the top of tools/build-macos-app.sh records what code-identity
         mistakes cost here — they break Automation consent invisibly. This one
         is pure managed, so it has no packaging consequences at all. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="PvRecorder" Version="1.2.13" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- AppKit-shaped control styles (MIT, Devolutions). Loaded only on macOS —
         see App.Initialize — with Fluent kept for Windows. Hand-rolling this was
         a losing game: the shapes, metrics and states of AppKit's controls are
         not published anywhere, and a drawn imitation maintained here drifts
         every time Apple moves. Requires Avalonia >= 11.3.7. -->
    <PackageReference Include="Devolutions.AvaloniaTheme.MacOS" Version="2026.6.16.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>
