<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeBuddy.OrbFlyout"
        Width="60" Height="28"
        SizeToContent="Manual"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <!-- Flyout actions arranged in a semicircular arc below the orb.
         The arrange button (always visible) sits at the 7-o'clock
         position and the mic button (only when voice input is enabled)
         sits at 5 o'clock — symmetric below the orb, so the pair reads
         as a radial menu belonging to it. The emerge-from-behind
         animation reinforces the relationship without needing a tether
         line: the flyout starts centred on the orb and slides straight
         down, so both buttons appear to grow out from behind the orb.

         Root is pinned and anchored top-left like OrbWindow's own Root:
         on Windows, the OS floors a top-level window at
         SM_CXMINTRACK/SM_CYMINTRACK (136x39 on stock Windows 11),
         so the leftover area is just transparent slack off to the right.
         Width/Height are adjusted dynamically by SetMicVisible — 60x28
         when both buttons are visible, 24x24 for the arrange button
         alone — so the hover hit area matches what's drawn. -->
    <Grid x:Name="Root"
          Width="60" Height="28"
          HorizontalAlignment="Left" VerticalAlignment="Top">

        <!-- At the 7-o'clock position within the arc: left of centre,
             so when both are visible the pair is symmetric around the
             orb's vertical axis. When the mic is hidden, SetMicVisible
             zeroes this margin and shrinks Root to 24x24. -->
        <Grid x:Name="ArrangeButton"
              Width="24" Height="24"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="1,2,0,0"
              Cursor="Hand">
            <Ellipse x:Name="ArrangeFill" Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
            <TextBlock Text="&#10024;"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- At the 5-o'clock position: right of centre, mirroring the
             arrange button across the orb's vertical axis. -->
        <Grid x:Name="MicButton"
              Width="24" Height="24"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="35,2,0,0"
              IsVisible="False"
              Cursor="Hand">
            <Ellipse Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
            <TextBlock Text="&#127908;"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
