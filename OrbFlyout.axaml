<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeBuddy.OrbFlyout"
        Width="70" Height="32"
        SizeToContent="Manual"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <!-- Flyout actions arranged in a semicircular arc below the orb.
         Button positions are computed trigonometrically by LayoutArc()
         so the curve adapts to the number of visible buttons: arrange
         and settings on the left of the arc, then speak, with mic at
         its right end when voice input is on.

         Root is a Canvas for absolute positioning. The transparent
         background keeps the whole bounding box hit-testable, which the
         hover bridge between the orb and flyout relies on. Width and
         Height are adjusted dynamically by LayoutArc(). On Windows the
         OS floors a top-level window at SM_CXMINTRACK/SM_CYMINTRACK, so
         the leftover area is transparent slack to the right — same
         reason OrbWindow anchors its own Root top-left. -->
    <Canvas x:Name="Root"
            Width="70" Height="32"
            Background="Transparent"
            HorizontalAlignment="Left" VerticalAlignment="Top">

        <Grid x:Name="ArrangeButton"
              Width="24" Height="24"
              Cursor="Hand">
            <Ellipse x:Name="ArrangeFill" Fill="#F01C1C1E" Stroke="#C0FFFFFF" StrokeThickness="1.5"/>
            <TextBlock Text="&#10024;"
                       FontSize="13"
                       Foreground="#F2FFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <Grid x:Name="SettingsButton"
              Width="24" Height="24"
              Cursor="Hand">
            <Ellipse Fill="#F01C1C1E" Stroke="#C0FFFFFF" StrokeThickness="1.5"/>
            <!-- Drawn, not typed (SymbolMarks.Gear, set in the constructor):
                 U+2699 falls back to Segoe UI Emoji on Windows and comes out
                 lavender beside a white mark everywhere else. -->
            <Path x:Name="SettingsMark"
                  Width="13" Height="13"
                  Stretch="Uniform"
                  Fill="#F2FFFFFF"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"/>
        </Grid>

        <!-- Speaks the latest assistant turn aloud via platform TTS.
             Its fill and glyph are named because SetSpeaking swaps both
             while speech is playing — the button doubles as the stop
             control, so it has to be able to say which it currently is. -->
        <Grid x:Name="SpeakButton"
              Width="24" Height="24"
              Cursor="Hand">
            <Ellipse x:Name="SpeakFill" Fill="#F01C1C1E" Stroke="#C0FFFFFF" StrokeThickness="1.5"/>
            <TextBlock x:Name="SpeakGlyph"
                       Text="&#128264;"
                       FontSize="13"
                       Foreground="#F2FFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
            <!-- The stop square while speech plays. Drawn for the reason
                 SymbolMarks gives, and shown instead of SpeakGlyph rather than
                 over it; see SymbolMarks.SpeakLook. -->
            <Path x:Name="SpeakStopMark"
                  Width="9" Height="9"
                  IsVisible="False"
                  Stretch="Uniform"
                  Fill="#F2FFFFFF"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"/>
        </Grid>

        <Grid x:Name="MicButton"
              Width="24" Height="24"
              IsVisible="False"
              Cursor="Hand">
            <Ellipse Fill="#F01C1C1E" Stroke="#C0FFFFFF" StrokeThickness="1.5"/>
            <TextBlock Text="&#127908;"
                       FontSize="13"
                       Foreground="#F2FFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- Opens the chat panel on this session.
             A separate button rather than a change to what clicking the orb
             does: for a Claude Code session the click already means "take me to
             that terminal", which is the oldest thing this app does and still
             the right default. This adds a second destination instead of
             replacing the first. Gateway orbs have no terminal to go to, so for
             those the click still opens the panel directly and this never
             appears. -->
        <Grid x:Name="ChatButton"
              Width="24" Height="24"
              IsVisible="False"
              Cursor="Hand">
            <Ellipse Fill="#F01C1C1E" Stroke="#C0FFFFFF" StrokeThickness="1.5"/>
            <!-- Drawn, not typed (SymbolMarks.Keyboard): U+2328 is Menlo on
                 macOS and Segoe UI Emoji on Windows. -->
            <Path x:Name="ChatMark"
                  Width="14" Height="14"
                  Stretch="Uniform"
                  Fill="#F2FFFFFF"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"/>
        </Grid>
    </Canvas>
</Window>
