<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeBuddy.OrbFlyout"
        Width="70" Height="32"
        SizeToContent="Manual"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <!-- Flyout actions arranged in a semicircular arc below the orb.
         Button positions are computed trigonometrically by LayoutArc()
         so the curve adapts to the number of visible buttons: arrange
         at 7 o'clock, settings at 6, mic at 5.

         Root is a Canvas for absolute positioning. The transparent
         background keeps the whole bounding box hit-testable, which the
         hover bridge between the orb and flyout relies on. Width and
         Height are adjusted dynamically by LayoutArc(). On Windows the
         OS floors a top-level window at SM_CXMINTRACK/SM_CYMINTRACK, so
         the leftover area is transparent slack to the right — same
         reason OrbWindow anchors its own Root top-left. -->
    <Canvas x:Name="Root"
            Width="70" Height="32"
            Background="Transparent"
            HorizontalAlignment="Left" VerticalAlignment="Top">

        <Grid x:Name="ArrangeButton"
              Width="24" Height="24"
              Cursor="Hand">
            <Ellipse x:Name="ArrangeFill" Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
            <TextBlock Text="&#10024;"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <Grid x:Name="SettingsButton"
              Width="24" Height="24"
              Cursor="Hand">
            <Ellipse Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
            <TextBlock Text="&#9881;"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <Grid x:Name="MicButton"
              Width="24" Height="24"
              IsVisible="False"
              Cursor="Hand">
            <Ellipse Fill="#E0202024" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
            <TextBlock Text="&#127908;"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>
    </Canvas>
</Window>
