<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>OpenClawProbe</AssemblyName>
    <RootNamespace>ClaudeBuddy</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia for ClaudeBuddySettings' Dispatcher use only; nothing here
         starts a UI, the same arrangement ArrangementTests already uses. -->
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped transport, compiled in rather than reimplemented: a probe
         that spoke to the gateway its own way could answer a question the app
         would answer differently, which is the one thing it must not do. -->
    <Compile Include="../../ClaudeBuddySettings.cs" />
    <!-- ClusterMode, which the settings' heartbeat and cron modes are typed as.
         Pure and window-free, so compiling it in costs nothing. -->
    <Compile Include="../../OrbClusters.cs" />
    <Compile Include="../../OpenClawSessionKind.cs" />
    <Compile Include="../../OpenClawIdentity.cs" />
    <Compile Include="../../OpenClawSocket.cs" />
    <Compile Include="../../OpenClawGateway.cs" />
  </ItemGroup>

</Project>
