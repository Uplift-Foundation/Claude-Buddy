.claude/

# Finder metadata. Written into any directory a Mac user so much as looks at, so
# a `git add -A` picks it up without anyone noticing — which is exactly how one
# got committed in 186b4ac.
.DS_Store

# NTFS alternate data streams, which arrive as "<file>:<stream>" — mark-of-the-web
# (":Zone.Identifier") and antivirus scan records (":mshield") are the usual ones.
# ":" is an illegal path character on Windows, so committing a single one of these
# makes the entire repository impossible to check out there.
*:*

# dotnet test --results-directory output (TRX files, and now the UI
# screenshot proof of concept's PNGs) — always local/CI-run artifacts, never
# something to commit.
/TestResults/
