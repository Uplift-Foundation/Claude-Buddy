<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeBuddy.OrbWindow"
        Title="Claude Buddy"
        Width="56" Height="56"
        MinWidth="56" MinHeight="56"
        MaxWidth="56" MaxHeight="56"
        SizeToContent="Manual"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <!-- Min/Max pin this to exactly 56x56 regardless of platform theme.
         Found the hard way on OrbFlyout: the Fluent theme (Windows) applies
         its own default Window MinWidth/MinHeight — measured at 120x39 —
         that silently overrides a plain Width/Height, since Min/Max act as
         a hard floor/ceiling on the final size no matter where the value
         setting them came from. This window's 56x56 happens to already
         clear that floor, which is exactly why the bug went unnoticed here
         and only showed up on OrbFlyout's much smaller 26x26 — pinned
         explicitly anyway, rather than relying on that margin staying true
         if Fluent's own default ever changes. -->

    <!-- Transparent (not null) background so the whole 56x56 area is
         hit-testable: hover tooltip, drag, and right-click work anywhere
         on the orb's square, not just the ellipse pixels. -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <!-- Chat name, then its directory. The path row hides itself
                     when there's no name yet, since it'd just repeat. -->
                <MenuItem x:Name="SessionInfoItem" IsEnabled="False"/>
                <MenuItem x:Name="SessionPathItem" IsEnabled="False"/>
                <Separator/>
                <!-- Only shown for an orb the user has dragged; see
                     OrbWindow.SetPinned. -->
                <MenuItem x:Name="ResetPositionItem"
                          Header="Return this orb to the stack"
                          IsVisible="False"
                          Click="ResetPosition_Click"/>
                <MenuItem Header="Reset this session to idle" Click="ResetIdle_Click"/>
                <MenuItem Header="Exit Claude Buddy" Click="Exit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Soft glow behind the orb (fill assigned in code-behind, shared
             with the orb so color fades hit both) -->
        <!-- Soft glow behind the orb. A RadialGradientBrush, not a BlurEffect:
             the orb animates continuously, and a blur next to it was re-blurred
             every frame at ~7% of a core per orb. Fill is assigned in
             code-behind so colour changes reach it. -->
        <Ellipse x:Name="Glow" Width="56" Height="56"/>

        <!-- The buddy itself -->
        <Ellipse x:Name="Orb"
                 Width="36" Height="36"
                 Stroke="#22FFFFFF"
                 StrokeThickness="1"/>

        <!-- Folder initial so you can tell orbs apart at a glance
             (falls back to a dot until the session reports its cwd) -->
        <TextBlock x:Name="Glyph"
                   Text="&#8226;"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#DDFFFFFF"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
